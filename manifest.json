{
  "manifest_version": 3,
  "name": "Multi-Engine Search Pro",
  "version": "2.0",
  "description": "Advanced multi-engine search with memory and bulk search capabilities",
  "permissions": ["tabs", "storage", "contextMenus", "tabGroups"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "omnibox": {
    "keyword": "ms"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}